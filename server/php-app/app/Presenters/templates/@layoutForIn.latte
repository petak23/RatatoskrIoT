<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="viewport" content="width=device-width, initial-scale=1"> 
	<meta name="robots" content="noindex, nofollow">
	<link href="{$basePath}/www/css/bootstrap.min.css" rel="stylesheet">
	<link href="{$basePath}/www/css/sign-in.css" rel="stylesheet">
	<title>{ifset title}{include title|stripHtml} | {/ifset}RatatoskrIoT</title>
	{control favicon}
</head>
<body>
<div class="row">
<h1 class="col-12 w-100 text-center py-2 bg-dark bg-gradient bg-opacity-75 text-light">{$appName}</h1>
<div class="col-12 col-md-9 mx-md-auto" n:if="count($flashes)" n:inner-foreach="$flashes as $flash">
	{first}
		<h2>Informace:</h2>	
	{/first}
	<div class="alert flash alert-{$flash->type} {$flash->type}"><b>{$flash->message}</b></div>
</div>
<main class="col-12 form-signin w-100 m-auto">
{include content}
</main>
<footer class="py-2 bg-dark mt-auto position-fixed bottom-0 end-0">
	<div class="container-fluid">
		<div class="d-flex align-items-center justify-content-between small">
			<div class="text-light small">{$appName}</div>
			<div n:inner-foreach="$links as $link" class="small">
				{if (strlen($link['link'])>0) }
					<a href="{$link['link']}" target="_blank">{$link['name']}</a>
				{else}
					{$link['name']}
				{/if}
				{sep}&middot;{/sep}
			</div>
		</div>
	</div>
</footer>

{block scripts}
	<script src="https://nette.github.io/resources/js/3/netteForms.min.js"></script>
	{*<script src="https://code.jquery.com/jquery-3.4.1.min.js" crossorigin="anonymous"></script>
	<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
	<script src="../www/js/scripts.js"></script>
	<script type="text/javascript">
	$(function () {
		$('[data-toggle="tooltip"]').tooltip()
	})
	</script>*}

	{control googleAnalytics}
	
{/block}

</body></html>
